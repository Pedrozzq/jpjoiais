    <!-- Toast de Notificação Geral (Substituindo alerts nativos) -->
    <div id="general-toast" class="fixed top-24 left-1/2 -translate-x-1/2 -translate-y-[200%] opacity-0 bg-zinc-900 text-white px-6 py-4 rounded-full shadow-[0_10px_40px_rgba(0,0,0,0.5)] z-[101] transition-all duration-500 ease-out flex items-center gap-3 border border-white/10 pointer-events-none">
        <div id="general-toast-icon" class="w-6 h-6 rounded-full flex items-center justify-center text-xs">
            <i class="fa-solid fa-info"></i>
        </div>
        <p id="general-toast-msg" class="text-[11px] uppercase tracking-wider font-medium"></p>
    </div>

    <!-- Toast de Notificação do Carrinho (Canto inferior) -->
    <div id="cart-toast" class="fixed bottom-5 right-5 translate-y-[150%] opacity-0 bg-white text-black px-6 py-4 rounded-lg shadow-[0_10px_40px_rgba(255,230,0,0.15)] z-[100] transition-all duration-500 ease-out flex items-center gap-4 border border-[#FFE600] pointer-events-none">
        <div class="w-8 h-8 rounded-full bg-[#FFE600]/20 flex items-center justify-center text-yellow-600">
            <i class="fa-solid fa-check"></i>
        </div>
        <div>
            <h4 class="text-xs font-bold uppercase tracking-wider mb-0.5">No Carrinho!</h4>
            <p id="cart-toast-msg" class="text-[10px] text-zinc-600">Produto adicionado com sucesso.</p>
        </div>
    </div>

    <!-- Overlay do Carrinho -->
    <div id="cart-overlay" onclick="closeCart()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99] hidden opacity-0 transition-opacity duration-500"></div>

    <!-- Carrinho Drawer Lateral -->
    <div id="cart-drawer" class="fixed inset-y-0 right-0 w-full md:w-[450px] bg-black/95 backdrop-blur-3xl z-[100] translate-x-full transition-transform duration-500 ease-out flex flex-col border-l border-white/10">
        
        <div class="flex justify-between items-center p-6 border-b border-white/10 bg-black/50 z-10">
            <h2 class="text-lg font-serif tracking-widest text-white uppercase flex items-center gap-3">
                <i class="fa-solid fa-cart-shopping text-[#FFE600] text-sm"></i> Seu Carrinho
            </h2>
            <button onclick="closeCart()" class="text-zinc-400 hover:text-[#FFE600] transition cursor-pointer p-2">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        
        <div class="relative flex-1 overflow-hidden flex">
            <!-- ETAPA 1 -->
            <div id="cart-step-1" class="w-full flex-shrink-0 flex flex-col h-full transition-transform duration-500 ease-in-out">
                <div id="cart-items-container" class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
                    <!-- Itens injetados pelo JS -->
                </div>
                
                <div class="p-6 border-t border-white/10 bg-zinc-950">
                    <div class="flex justify-between items-center mb-6">
                        <span class="text-xs uppercase tracking-widest text-zinc-400">Total</span>
                        <span id="cart-total" class="text-xl font-bold text-white product-price">R$ 0,00</span>
                    </div>
                    <button onclick="goToShippingStep()" class="w-full py-4 bg-[#FFE600] text-black font-bold rounded-full text-[10px] uppercase tracking-[0.2em] hover:bg-yellow-400 transition-colors flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(255,230,0,0.15)]">
                        AVANÇAR PARA ENTREGA <i class="fa-solid fa-arrow-right text-[12px]"></i>
                    </button>
                    <button onclick="closeCart()" class="w-full mt-4 text-[9px] uppercase tracking-[0.2em] text-zinc-500 hover:text-white transition-colors">
                        CONTINUAR COMPRANDO
                    </button>
                </div>
            </div>

            <!-- ETAPA 2 -->
            <div id="cart-step-2" class="w-full flex-shrink-0 flex flex-col h-full absolute top-0 left-full transition-transform duration-500 ease-in-out">
                <div class="flex-1 overflow-y-auto p-6 flex flex-col">
                    <button onclick="backToCartStep()" class="text-[10px] text-zinc-400 uppercase tracking-widest hover:text-[#FFE600] flex items-center gap-2 mb-6 w-fit transition">
                        <i class="fa-solid fa-arrow-left"></i> Voltar aos itens
                    </button>
                    <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-white mb-6 border-b border-white/10 pb-3">Informações de Envio</h3>
                    
                    <form id="shipping-form" class="flex flex-col gap-4">
                        <div><input type="text" id="ship-nome" required placeholder="NOME COMPLETO" class="shipping-input"></div>
                        <div><input type="text" id="ship-cpf" required placeholder="CPF" class="shipping-input"></div>
                        <div><input type="tel" id="ship-whatsapp" required placeholder="WHATSAPP (DDD + NÚMERO)" class="shipping-input"></div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <input type="text" id="ship-cep" required placeholder="CEP" maxlength="9" onblur="buscarCEP(this.value)" class="shipping-input">
                                <span id="cep-feedback" class="text-[9px] text-[#FFE600] mt-1 hidden">Buscando CEP...</span>
                            </div>
                            <div><input type="text" id="ship-estado" required placeholder="ESTADO (UF)" maxlength="2" class="shipping-input uppercase"></div>
                        </div>
                        <div><input type="text" id="ship-cidade" required placeholder="CIDADE" class="shipping-input"></div>
                        <div><input type="text" id="ship-bairro" required placeholder="BAIRRO" class="shipping-input"></div>
                        <div class="grid grid-cols-3 gap-4">
                            <div class="col-span-2"><input type="text" id="ship-rua" required placeholder="RUA / LOGRADOURO" class="shipping-input"></div>
                            <div><input type="text" id="ship-numero" required placeholder="NÚMERO" class="shipping-input"></div>
                        </div>
                    </form>
                </div>
                
                <div class="p-6 border-t border-white/10 bg-zinc-950">
                    <div class="flex justify-between items-center mb-6">
                        <span class="text-xs uppercase tracking-widest text-zinc-400">Total a Pagar</span>
                        <span id="cart-total-step2" class="text-xl font-bold text-white product-price">R$ 0,00</span>
                    </div>
                    <button onclick="finalizarCompra()" id="btn-finalizar" class="w-full py-4 bg-[#FFE600] text-black font-bold rounded-full text-[10px] uppercase tracking-[0.2em] hover:bg-yellow-400 transition-colors flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(255,230,0,0.15)]">
                        <i class="fa-solid fa-lock text-[12px]"></i> FINALIZAR E PAGAR
                    </button>
                    <p class="text-center text-[8px] text-zinc-600 uppercase tracking-widest mt-4">Transação 100% segura via Mercado Pago</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- Função de Notificação Customizada (Substitui o alert nativo) ---
        function showNotification(msg, isError = false) {
            const toast = document.getElementById('general-toast');
            const toastMsg = document.getElementById('general-toast-msg');
            const iconContainer = document.getElementById('general-toast-icon');
            
            toastMsg.innerText = msg;
            
            if (isError) {
                toast.classList.replace('border-white/10', 'border-red-500/50');
                iconContainer.classList.replace('bg-white/10', 'bg-red-500/20');
                iconContainer.classList.replace('text-white', 'text-red-400');
                iconContainer.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
            } else {
                toast.classList.replace('border-red-500/50', 'border-white/10');
                iconContainer.classList.replace('bg-red-500/20', 'bg-[#FFE600]/20');
                iconContainer.classList.replace('text-red-400', 'text-[#FFE600]');
                iconContainer.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            toast.classList.remove('-translate-y-[200%]', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('-translate-y-[200%]', 'opacity-0');
            }, 3500);
        }

        // --- Animações da Página Inicial ---
        window.addEventListener('load', () => {
            gsap.registerPlugin(ScrollTrigger);
            
            const tl = gsap.timeline();
            tl.to("#loader-brand", { opacity: 1, y: 0, duration: 1, ease: "power2.out" })
              .to("#loader-progress", { width: "120px", duration: 1.2, ease: "power2.inOut" }, "-=0.5")
              .to("#loader", { opacity: 0, pointerEvents: "none", duration: 1, ease: "power2.inOut" })
              .to("#policy-wrapper", { opacity: 1, duration: 1.5, ease: "power2.out" }, "-=0.5");

            // Animação dos blocos conforme rola a página
            gsap.utils.toArray('.policy-section').forEach(section => {
                gsap.to(section, {
                    scrollTrigger: {
                        trigger: section,
                        start: "top 90%",
                    },
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out"
                });
            });

            // Navbar scrolando
            ScrollTrigger.create({
                start: 'top -40',
                onUpdate: (self) => {
                    const nav = document.getElementById('main-nav');
                    if (self.direction === 1) nav.classList.add('scrolled');
                    else if (self.scroll() < 40) nav.classList.remove('scrolled');
                }
            });
        });

        // --- Lógica dos Menus ---
        const menuToggleBtn = document.getElementById('menu-toggle-btn');
        const menuCloseBtn = document.getElementById('menu-close-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        function openMenu() { mobileMenu.classList.remove('translate-x-full'); }
        function closeMenu() { mobileMenu.classList.add('translate-x-full'); }

        menuToggleBtn.addEventListener('click', openMenu);
        menuCloseBtn.addEventListener('click', closeMenu);

        // --- Lógica de Carrinho ---
        let cartItems = [];

        function formatMoney(amount) {
            return amount.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function updateCartUI() {
            const totalItems = cartItems.reduce((acc, item) => acc + item.quantity, 0);
            document.getElementById('cart-count').innerText = totalItems;
            
            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';
            
            if (cartItems.length === 0) {
                container.innerHTML = '<p class="text-zinc-500 text-xs text-center my-auto flex-1 flex items-center justify-center uppercase tracking-widest">Seu carrinho está vazio.</p>';
            } else {
                cartItems.forEach((item, index) => {
                    let imageHTML = '';
                    if (Array.isArray(item.image)) {
                        const widthClass = item.image.length === 2 ? 'w-1/2' : 'w-1/3';
                        imageHTML = '<div class="flex w-full h-full gap-[1px] bg-black p-[1px]">';
                        item.image.forEach(imgUrl => {
                            imageHTML += `<div class="${widthClass} h-full bg-cover bg-center opacity-90 group-hover:opacity-100 transition" style="background-image: url('${imgUrl}')"></div>`;
                        });
                        imageHTML += '</div>';
                    } else {
                        imageHTML = `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition">`;
                    }

                    container.innerHTML += `
                        <div class="flex gap-4 items-center bg-white/[0.02] p-3 rounded-lg border border-white/5 relative group">
                            <div class="w-16 h-20 bg-black rounded overflow-hidden flex-shrink-0 border border-white/10">
                                ${imageHTML}
                            </div>
                            <div class="flex-1">
                                <h4 class="text-[10px] text-[#FFE600] uppercase tracking-wider mb-1 pr-6 leading-relaxed">${item.name}</h4>
                                <span class="text-xs text-white font-bold">${formatMoney(item.price)}</span>
                                <div class="flex items-center gap-3 mt-2 bg-black w-fit rounded-full px-2 py-1 border border-white/10">
                                    <button onclick="changeQuantity(${index}, -1)" class="text-zinc-400 hover:text-[#FFE600] transition w-4 h-4 flex items-center justify-center"><i class="fa-solid fa-minus text-[8px]"></i></button>
                                    <span class="text-[10px] text-zinc-300 font-medium w-4 text-center">${item.quantity}</span>
                                    <button onclick="changeQuantity(${index}, 1)" class="text-zinc-400 hover:text-[#FFE600] transition w-4 h-4 flex items-center justify-center"><i class="fa-solid fa-plus text-[8px]"></i></button>
                                </div>
                            </div>
                            <button onclick="removeFromCart(${index})" class="absolute top-3 right-3 text-zinc-600 hover:text-red-500 transition px-1">
                                <i class="fa-solid fa-trash text-xs"></i>
                            </button>
                        </div>
                    `;
                });
            }
            
            const total = cartItems.reduce((acc, item) => acc + (item.price * item.quantity), 0);
            document.getElementById('cart-total').innerText = formatMoney(total);
            document.getElementById('cart-total-step2').innerText = formatMoney(total);
        }

        function changeQuantity(index, delta) {
            if (cartItems[index].quantity + delta > 0) {
                cartItems[index].quantity += delta;
            } else {
                removeFromCart(index);
            }
            updateCartUI();
        }

        function removeFromCart(index) {
            cartItems.splice(index, 1);
            updateCartUI();
            if(cartItems.length === 0) backToCartStep();
        }

        function openCart() {
            document.getElementById('cart-drawer').classList.remove('translate-x-full');
            const overlay = document.getElementById('cart-overlay');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
        }

        function closeCart() {
            document.getElementById('cart-drawer').classList.add('translate-x-full');
            const overlay = document.getElementById('cart-overlay');
            overlay.classList.add('opacity-0');
            setTimeout(() => {
                overlay.classList.add('hidden');
                backToCartStep();
            }, 500);
        }

        function goToShippingStep() {
            if (cartItems.length === 0) { 
                showNotification("Adicione itens ao carrinho primeiro.", true);
                return; 
            }
            document.getElementById('cart-step-1').style.transform = 'translateX(-100%)';
            document.getElementById('cart-step-2').style.transform = 'translateX(-100%)';
        }

        function backToCartStep() {
            document.getElementById('cart-step-1').style.transform = 'translateX(0)';
            document.getElementById('cart-step-2').style.transform = 'translateX(0)';
        }

        async function buscarCEP(cepInput) {
            const cep = cepInput.replace(/\D/g, '');
            const feedback = document.getElementById('cep-feedback');
            if (cep.length === 8) {
                feedback.classList.remove('hidden');
                feedback.innerText = "Buscando CEP...";
                feedback.classList.replace('text-red-400', 'text-[#FFE600]');
                try {
                    const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
                    const data = await response.json();
                    if (!data.erro) {
                        document.getElementById('ship-rua').value = data.logradouro;
                        document.getElementById('ship-bairro').value = data.bairro;
                        document.getElementById('ship-cidade').value = data.localidade;
                        document.getElementById('ship-estado').value = data.uf;
                        document.getElementById('ship-numero').focus();
                        feedback.classList.add('hidden');
                    } else {
                        feedback.innerText = "CEP não encontrado.";
                        feedback.classList.replace('text-[#FFE600]', 'text-red-400');
                    }
                } catch (err) {
                    feedback.classList.add('hidden');
                }
            }
        }

        async function finalizarCompra() {
            const form = document.getElementById('shipping-form');
            if (!form.checkValidity()) { form.reportValidity(); return; }

            const btn = document.getElementById('btn-finalizar');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-[12px]"></i> PROCESSANDO...';
            btn.disabled = true;

            const shippingData = {
                nome: document.getElementById('ship-nome').value,
                cpf: document.getElementById('ship-cpf').value,
                whatsapp: document.getElementById('ship-whatsapp').value,
                cep: document.getElementById('ship-cep').value,
                rua: document.getElementById('ship-rua').value,
                numero: document.getElementById('ship-numero').value,
                bairro: document.getElementById('ship-bairro').value,
                cidade: document.getElementById('ship-cidade').value,
                estado: document.getElementById('ship-estado').value
            };

            try {
                const response = await fetch("https://jpjoiais.vercel.app/api/checkout", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ items: cartItems, shipping: shippingData })
                });

                const data = await response.json();
                if (data.init_point) {
                    window.location.href = data.init_point;
                } else {
                    showNotification("Erro ao criar pagamento. Verifique os dados.", true);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                showNotification("Erro ao conectar com o servidor.", true);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
